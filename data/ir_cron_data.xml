<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The visitor's IP is kept only for the upload rate limit (10 minutes); a daily job erases it. -->
    <record id="ir_cron_purge_submitter_ip" model="ir.cron">
        <field name="name">Customer Photos: erase submitter IPs</field>
        <field name="model_id" ref="model_mconfort_customer_photo"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_submitter_ip()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
