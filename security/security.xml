<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_customer_photos" model="res.groups.privilege">
        <field name="name">Customer Photos</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Validator</field>
        <field name="privilege_id" ref="res_groups_privilege_customer_photos"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <!-- Administrators get it without a click; staff are added by hand in Settings ▸ Users. -->
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="comment">Receives an activity for every new customer photo and can approve or reject it.</field>
    </record>

    <record id="rule_customer_photo_public" model="ir.rule">
        <field name="name">Customer photo: public/portal: published only</field>
        <field name="model_id" ref="model_mconfort_customer_photo"/>
        <field name="domain_force">[('website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_customer_photo_image_public" model="ir.rule">
        <field name="name">Customer photo image: public/portal: published only</field>
        <field name="model_id" ref="model_mconfort_customer_photo_image"/>
        <field name="domain_force">[('submission_id.website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
