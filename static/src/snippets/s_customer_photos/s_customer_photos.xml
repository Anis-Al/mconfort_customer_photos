<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mconfort_customer_photos.FeaturedMosaic">
        <div t-attf-class="s_cp_mosaic s_cp_mosaic_n{{photos.length}}">
            <t t-foreach="photos" t-as="photo" t-key="photo_index">
                <figure class="s_cp_tile">
                    <img t-if="photo.image" t-att-src="photo.image" t-att-alt="photo.alt" loading="lazy"/>
                    <a t-if="photo.url" t-att-href="photo.url" class="s_cp_link" t-att-aria-label="photo.caption"/>
                    <figcaption t-if="photo.caption" class="s_cp_caption"><i class="fa fa-camera" role="img"/> <t t-out="photo.caption"/></figcaption>
                </figure>
            </t>
        </div>
    </t>

</templates>
